Screen {
    background: $surface;
}

#menu-container {
    align: center middle;
    height: 1fr;
    padding: 1 2;
}

#menu-title {
    text-align: center;
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

#menu-subtitle {
    text-align: center;
    color: $text-muted;
    margin-bottom: 1;
}

#main-options {
    width: 65;
    height: auto;
    border: round $primary;
}

#profiles-container {
    padding: 1 2;
    height: 1fr;
}

SearchBar {
    height: auto;
    margin-bottom: 1;
}

#search-input {
    width: 100%;
    border: tall $accent;
}

#table-container {
    height: 1fr;
    border: round $primary;
    padding: 0 1;
}

#profiles-table {
    height: 1fr;
}

PaginationBar {
    height: 3;
    align: center middle;
    margin-top: 1;
}

PaginationBar Button {
    margin: 0 1;
    min-width: 14;
}

#page-label {
    content-align: center middle;
    text-style: bold;
    width: 30;
}

ProfileDetailModal {
    align: center middle;
    background: rgba(0, 0, 0, 0.7);
}

#dialog-container {
    width: 85%;
    height: 85%;
    background: $surface;
    border: thick $primary;
    padding: 1 2;
}

#modal-title {
    text-align: center;
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

#modal-table {
    height: 1fr;
    border: solid $secondary;
    margin-bottom: 1;
}

#modal-actions {
    height: auto;
    align: center middle;
}

#btn-close {
    min-width: 20;
}

ConfirmDeleteModal {
    align: center middle;
    background: rgba(0, 0, 0, 0.7);
}

#confirm-container {
    width: 60;
    height: auto;
    background: $surface;
    border: thick $error;
    padding: 1 2;
}

#confirm-title {
    text-align: center;
    text-style: bold;
    color: $error;
}

#confirm-subtitle {
    text-align: center;
    color: $text-muted;
    margin-bottom: 1;
}

#confirm-actions {
    height: auto;
    align: center middle;
}

#confirm-actions Button {
    margin: 0 1;
    min-width: 16;
}

#live-container {
    padding: 1 2;
    height: 1fr;
}

#active-title {
    text-style: bold;
    color: $accent;
    margin-bottom: 0;
}

#active-card {
    height: auto;
    border: round $primary;
    padding: 0 1;
    margin-bottom: 1;
}

#active-status-label {
    text-style: bold;
}

#nearby-title {
    text-style: bold;
    color: $secondary;
    margin-bottom: 0;
}

#nearby-table {
    height: 1fr;
    border: round $secondary;
}

#diag-container {
    padding: 1 2;
    height: 1fr;
}

#driver-title {
    text-style: bold;
    color: $accent;
    margin-bottom: 0;
}

#driver-table {
    height: 1fr;
    border: round $primary;
    margin-bottom: 1;
}

#ipv4-title {
    text-style: bold;
    color: $secondary;
    margin-bottom: 0;
}

#ipv4-table {
    height: 1fr;
    border: round $secondary;
}

#speedtest-container {
    padding: 1 2;
    height: 1fr;
}

#speedtest-title {
    text-style: bold;
    color: $accent;
    margin-bottom: 0;
}

#speedtest-status {
    text-style: italic;
    color: $text;
    margin-bottom: 1;
}

#speedtest-loader {
    height: 3;
    margin-bottom: 1;
}

#summary-title {
    text-style: bold;
    color: $secondary;
    margin-bottom: 0;
}

#summary-table {
    height: auto;
    max-height: 8;
    border: round $primary;
    margin-bottom: 1;
}

#history-title {
    text-style: bold;
    color: $secondary;
    margin-bottom: 0;
}

#history-table {
    height: 1fr;
    border: round $secondary;
}
